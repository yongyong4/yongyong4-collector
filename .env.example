# 공공데이터포털 인증키 (일반 인증키 Decoding 값). job 의 api-key-env 이름과 맞춘다
DATA_GO_KR_KEY_EXPRESS=
# 시내버스 job 추가 시
DATA_GO_KR_KEY_CITY=

# MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=busdata
DB_USER=bus
DB_PASSWORD=

# 설정하면 /admin/**, /export 호출 시 X-Admin-Token 헤더(또는 ?token=) 필요
ADMIN_TOKEN=

# 텔레그램 알림 (둘 다 있어야 켜짐). @BotFather 로 봇 생성 → 봇에게 /start → chat_id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 선택: 외부 감시 서비스(healthchecks.io 등) ping URL. 정해진 주기마다 호출, 끊기면 그 서비스가 알려줌
HEALTHCHECK_URL=
